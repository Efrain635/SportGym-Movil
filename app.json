{
  "expo": {
    "name": "SportGym",
    "slug": "SportGym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sportgym",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permite que SportGym use el reconocimiento de voz",
        "NSMicrophoneUsageDescription": "Permite que SportGym use tu micrófono para reconocimiento de voz"
      },
      "bitcode": false
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.jpeg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.byron635.SportGym"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4C9A3A",
          "image": "./assets/images/logo-glow.png",
          "imageWidth": 150
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que SportGym use tu cámara para escanear códigos QR",
          "microphonePermission": "Permite que SportGym use tu micrófono",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite que SportGym use tu micrófono para reconocimiento de voz",
          "speechRecognitionPermission": "Permite que SportGym use el reconocimiento de voz"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15ee74c0-c9c6-440f-9b1b-88bc54c4e015"
      }
    },
    "owner": "efrain635"
  }
}
