rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "admin";
    }

    function ownsClient(clientId) {
      let clientPath = /databases/$(database)/documents/clientes/$(clientId);
      return signedIn()
        && (
          request.auth.uid == clientId
          || request.auth.token.get("clienteId", "") == clientId
          || (
            exists(clientPath)
            && (
              get(clientPath).data.get("uid", "") == request.auth.uid
              || (
                get(clientPath).data.keys().hasAny(["correo"])
                && get(clientPath).data.correo == request.auth.token.email
              )
              || (
                get(clientPath).data.keys().hasAny(["email"])
                && get(clientPath).data.email == request.auth.token.email
              )
            )
          )
        );
    }

    function ownsClientDocumentId(documentId) {
      return signedIn()
        && (
          documentId.matches("^" + request.auth.uid + "_.*$")
          || documentId.matches(
            "^" + request.auth.token.get("clienteId", "") + "_.*$"
          )
        );
    }

    match /productos/{document=**} {
      allow read: if true;
    }

    match /recetas/{document=**} {
      allow read: if true;
    }

    match /usernames/{username} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.username is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /usuarios/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /clientes/{clientId} {
      function validClientCreation() {
        return signedIn()
          && request.auth.uid == clientId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.correo == request.auth.token.email
          && request.resource.data.usuario is string
          && request.resource.data.nombre is string
          && request.resource.data.apellido is string
          && request.resource.data.telefono is string
          && request.resource.data.asistencias is list;
      }

      function attendanceOnlyUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "asistencias",
          "rachaAsistencia",
          "mejorRachaAsistencia",
          "totalAsistencias"
        ])
        && request.resource.data.asistencias is list
        && request.resource.data.rachaAsistencia is int
        && request.resource.data.rachaAsistencia >= 0
        && request.resource.data.mejorRachaAsistencia is int
        && request.resource.data.mejorRachaAsistencia >= 0
        && request.resource.data.totalAsistencias is int
        && request.resource.data.totalAsistencias >= 0;
      }

      function validClientProfileUpdate() {
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();
        return changedFields.hasAll(["nombre", "apellido", "fechaUltimoCambio"])
          && changedFields.hasOnly([
            "nombre",
            "apellido",
            "telefono",
            "fechaNacimiento",
            "genero",
            "peso",
            "estatura",
            "nivel",
            "fechaUltimoCambio"
          ])
          && request.resource.data.nombre is string
          && request.resource.data.apellido is string
          && (
            !changedFields.hasAny(["telefono"])
            || request.resource.data.telefono == null
            || request.resource.data.telefono is string
          )
          && (
            !changedFields.hasAny(["fechaNacimiento"])
            || request.resource.data.fechaNacimiento == null
            || request.resource.data.fechaNacimiento is string
          )
          && (
            !changedFields.hasAny(["genero"])
            || request.resource.data.genero == null
            || request.resource.data.genero is string
          )
          && (
            !changedFields.hasAny(["peso"])
            || request.resource.data.peso == null
            || (
              request.resource.data.peso is number
              && request.resource.data.peso >= 20
              && request.resource.data.peso <= 400
            )
          )
          && (
            !changedFields.hasAny(["estatura"])
            || request.resource.data.estatura == null
            || (
              request.resource.data.estatura is number
              && request.resource.data.estatura >= 100
              && request.resource.data.estatura <= 250
            )
          )
          && (
            !changedFields.hasAny(["nivel"])
            || request.resource.data.nivel
              in ["principiante", "intermedio", "avanzado"]
          )
          && request.resource.data.fechaUltimoCambio is timestamp;
      }

      function validClientPreferencesUpdate() {
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();
        return changedFields.hasAny([
            "objetivo",
            "nivel",
            "diasEntrenamiento",
            "maquinasDisponibles",
            "maquinas",
            "restricciones"
          ])
          && changedFields.hasOnly([
            "objetivo",
            "nivel",
            "diasEntrenamiento",
            "maquinasDisponibles",
            "maquinas",
            "restricciones",
            "fechaUltimoCambio"
          ])
          && request.resource.data.objetivo is string
          && request.resource.data.nivel
            in ["principiante", "intermedio", "avanzado"]
          && request.resource.data.diasEntrenamiento is int
          && request.resource.data.diasEntrenamiento >= 1
          && request.resource.data.diasEntrenamiento <= 7
          && request.resource.data.maquinasDisponibles is list
          && request.resource.data.maquinas is list
          && request.resource.data.restricciones is list
          && request.resource.data.fechaUltimoCambio is timestamp;
      }

      function validWeightProgressUpdate() {
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();
        let progress = request.resource.data.get("progreso", {});
        let previousProgress = resource.data.get("progreso", {});
        let weights = progress.get("pesos", []);
        let latestWeight = weights[weights.size() - 1];
        return changedFields.hasAll(["progreso", "fechaUltimoCambio"])
          && changedFields.hasOnly(["progreso", "peso", "fechaUltimoCambio"])
          && progress is map
          && progress.keys().hasAll(["pesos", "fechaActualizacion"])
          && progress.diff(previousProgress).affectedKeys()
            .hasOnly(["pesos", "fechaActualizacion"])
          && weights is list
          && weights.size() > 0
          && latestWeight is map
          && latestWeight.keys().hasAll(["peso", "fecha"])
          && latestWeight.peso == request.resource.data.peso
          && latestWeight.fecha is string
          && latestWeight.fecha.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.peso is number
          && request.resource.data.peso >= 20
          && request.resource.data.peso <= 400
          && request.resource.data.fechaUltimoCambio is timestamp
          && progress.fechaActualizacion is timestamp;
      }

      function validProgressGoalUpdate() {
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();
        let progress = request.resource.data.get("progreso", {});
        let previousProgress = resource.data.get("progreso", {});
        return changedFields.hasAll(["progreso", "fechaUltimoCambio"])
          && changedFields.hasOnly([
            "progreso",
            "objetivo",
            "pesoObjetivo",
            "fechaUltimoCambio"
          ])
          && progress is map
          && progress.keys().hasAll([
            "objetivo",
            "pesoObjetivo",
            "fechaActualizacion"
          ])
          && progress.diff(previousProgress).affectedKeys()
            .hasOnly(["objetivo", "pesoObjetivo", "fechaActualizacion"])
          && request.resource.data.objetivo is string
          && request.resource.data.objetivo.size() > 0
          && request.resource.data.objetivo.size() <= 100
          && progress.objetivo == request.resource.data.objetivo
          && (
            request.resource.data.pesoObjetivo == null
            || (
              request.resource.data.pesoObjetivo is number
              && request.resource.data.pesoObjetivo >= 20
              && request.resource.data.pesoObjetivo <= 400
            )
          )
          && progress.pesoObjetivo == request.resource.data.pesoObjetivo
          && request.resource.data.fechaUltimoCambio is timestamp
          && progress.fechaActualizacion is timestamp;
      }

      function validMeasurementProgressUpdate() {
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();
        let progress = request.resource.data.get("progreso", {});
        let previousProgress = resource.data.get("progreso", {});
        let measurements = progress.get("medidas", []);
        let latestMeasurement = measurements[measurements.size() - 1];
        return changedFields.hasAll(["progreso", "fechaUltimoCambio"])
          && changedFields.hasOnly(["progreso", "fechaUltimoCambio"])
          && progress is map
          && progress.keys().hasAll(["medidas", "fechaActualizacion"])
          && progress.diff(previousProgress).affectedKeys()
            .hasOnly(["medidas", "fechaActualizacion"])
          && measurements is list
          && measurements.size() > 0
          && latestMeasurement is map
          && latestMeasurement.keys().hasOnly([
            "fecha",
            "cintura",
            "cadera",
            "brazos",
            "muslos"
          ])
          && latestMeasurement.keys().hasAll(["fecha"])
          && latestMeasurement.keys().hasAny([
            "cintura",
            "cadera",
            "brazos",
            "muslos"
          ])
          && latestMeasurement.fecha is string
          && latestMeasurement.fecha.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && (
            !latestMeasurement.keys().hasAny(["cintura"])
            || (
              latestMeasurement.cintura is number
              && latestMeasurement.cintura >= 10
              && latestMeasurement.cintura <= 250
            )
          )
          && (
            !latestMeasurement.keys().hasAny(["cadera"])
            || (
              latestMeasurement.cadera is number
              && latestMeasurement.cadera >= 10
              && latestMeasurement.cadera <= 250
            )
          )
          && (
            !latestMeasurement.keys().hasAny(["brazos"])
            || (
              latestMeasurement.brazos is number
              && latestMeasurement.brazos >= 10
              && latestMeasurement.brazos <= 250
            )
          )
          && (
            !latestMeasurement.keys().hasAny(["muslos"])
            || (
              latestMeasurement.muslos is number
              && latestMeasurement.muslos >= 10
              && latestMeasurement.muslos <= 250
            )
          )
          && request.resource.data.fechaUltimoCambio is timestamp
          && progress.fechaActualizacion is timestamp;
      }

      allow get: if ownsClient(clientId);
      allow list: if signedIn()
        && (
          isAdmin()
          || (
            request.auth.token.email is string
            && (
              resource.data.get("correo", "") == request.auth.token.email
              || resource.data.get("email", "") == request.auth.token.email
            )
          )
        );
      allow create: if validClientCreation();
      allow update: if ownsClient(clientId)
        && (
          attendanceOnlyUpdate()
          || validClientProfileUpdate()
          || validClientPreferencesUpdate()
          || validWeightProgressUpdate()
          || validProgressGoalUpdate()
          || validMeasurementProgressUpdate()
        );
    }

    match /asistencias/{attendanceId} {
      allow get: if ownsClientDocumentId(attendanceId);
      allow list: if ownsClient(resource.data.cliente);
      allow create: if request.resource.data.keys().hasAll([
          "nombreUsuario",
          "usuario",
          "hora",
          "fecha",
          "cliente",
          "nombreCliente",
          "estado"
        ])
        && request.resource.data.cliente is string
        && ownsClient(request.resource.data.cliente)
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches(
          "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        )
        && (
          attendanceId
            == request.auth.uid + "_" + request.resource.data.fecha
          || attendanceId
            == request.auth.token.get("clienteId", "")
              + "_" + request.resource.data.fecha
        )
        && request.resource.data.nombreUsuario is string
        && request.resource.data.usuario is string
        && request.resource.data.hora is timestamp
        && request.resource.data.nombreCliente is string
        && request.resource.data.estado == "presente";
    }

    match /favoritos_recetas/{favoriteId} {
      allow get: if ownsClientDocumentId(favoriteId)
        || ownsClient(resource.data.clienteId);
      allow list: if ownsClient(resource.data.clienteId);
      allow create, update: if request.resource.data.clienteId is string
        && request.resource.data.recetaId is string
        && favoriteId
          == request.resource.data.clienteId
            + "_"
            + request.resource.data.recetaId
        && ownsClient(request.resource.data.clienteId);

      allow delete: if ownsClient(resource.data.clienteId);
    }

    match /favoritos/{favoriteId} {
      allow get: if ownsClientDocumentId(favoriteId)
        || ownsClient(resource.data.clienteId);
      allow list: if ownsClient(resource.data.clienteId);
      allow create, update: if request.resource.data.clienteId is string
        && request.resource.data.ejercicioId is string
        && favoriteId
          == request.resource.data.clienteId
            + "_"
            + request.resource.data.ejercicioId
        && ownsClient(request.resource.data.clienteId);

      allow delete: if ownsClient(resource.data.clienteId);
    }

    match /rutinas/{routineId} {
      function validRoutineData() {
        return request.resource.data.clienteId is string
          && request.resource.data.ejercicioId is string
          && request.resource.data.ejercicioNombre is string
          && request.resource.data.dia is string
          && ownsClient(request.resource.data.clienteId);
      }

      allow create: if validRoutineData();

      allow update: if validRoutineData()
        && resource.data.clienteId == request.resource.data.clienteId
        && ownsClient(resource.data.clienteId);

      allow read, delete: if ownsClient(resource.data.clienteId);
    }

    match /entrenamientos/{workoutId} {
      allow read: if ownsClient(resource.data.clienteId);
      allow create: if request.resource.data.keys().hasAll([
          "clienteId",
          "clienteUsuario",
          "clienteNombre",
          "dia",
          "estado",
          "fechaInicio",
          "fechaFinalizacion",
          "duracionSegundos",
          "duracionMinutos",
          "totalEjercicios",
          "ejercicios"
        ])
        && request.resource.data.clienteId is string
        && ownsClient(request.resource.data.clienteId)
        && request.resource.data.clienteUsuario is string
        && request.resource.data.clienteNombre is string
        && request.resource.data.dia is string
        && request.resource.data.estado == "completado"
        && request.resource.data.fechaInicio is timestamp
        && request.resource.data.fechaFinalizacion is timestamp
        && request.resource.data.duracionSegundos is int
        && request.resource.data.duracionSegundos > 0
        && request.resource.data.duracionMinutos is int
        && request.resource.data.duracionMinutos > 0
        && request.resource.data.totalEjercicios is int
        && request.resource.data.totalEjercicios > 0
        && request.resource.data.ejercicios is list
        && request.resource.data.ejercicios.size()
          == request.resource.data.totalEjercicios;
    }

    match /conversaciones_chatbot/{conversationId} {
      allow create: if request.resource.data.clienteId is string
        && ownsClient(request.resource.data.clienteId);

      allow read, delete: if ownsClient(resource.data.clienteId);

      allow update: if ownsClient(resource.data.clienteId)
        && request.resource.data.clienteId == resource.data.clienteId;

      match /mensajes/{messageId} {
        function ownsConversation() {
          let conversationPath =
            /databases/$(database)/documents/conversaciones_chatbot/$(conversationId);
          return exists(conversationPath)
            && ownsClient(get(conversationPath).data.clienteId);
        }

        allow read, delete: if ownsConversation();

        allow create: if ownsConversation()
          && request.resource.data.from in ["user", "bot"]
          && request.resource.data.text is string;
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
