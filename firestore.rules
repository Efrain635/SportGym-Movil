rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsClient(clientId) {
      let clientPath = /databases/$(database)/documents/clientes/$(clientId);
      return request.auth != null
        && (
          request.auth.uid == clientId
          || (
            exists(clientPath)
            && (
              (
                get(clientPath).data.keys().hasAny(["correo"])
                && get(clientPath).data.correo == request.auth.token.email
              )
              || (
                get(clientPath).data.keys().hasAny(["email"])
                && get(clientPath).data.email == request.auth.token.email
              )
            )
          )
        );
    }

    match /productos/{document=**} {
      allow read: if true;
    }

    match /recetas/{document=**} {
      allow read: if true;
    }

    match /clientes/{clientId} {
      function attendanceOnlyUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "asistencias",
          "rachaAsistencia",
          "mejorRachaAsistencia",
          "totalAsistencias"
        ])
        && request.resource.data.asistencias is list
        && request.resource.data.rachaAsistencia is int
        && request.resource.data.rachaAsistencia >= 0
        && request.resource.data.mejorRachaAsistencia is int
        && request.resource.data.mejorRachaAsistencia >= 0
        && request.resource.data.totalAsistencias is int
        && request.resource.data.totalAsistencias >= 0;
      }

      function validWeightProgressUpdate() {
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();
        let progress = request.resource.data.get("progreso", {});
        let previousProgress = resource.data.get("progreso", {});
        let weights = progress.get("pesos", []);
        let latestWeight = weights[weights.size() - 1];
        return changedFields.hasAll(["progreso", "fechaUltimoCambio"])
          && changedFields.hasOnly(["progreso", "peso", "fechaUltimoCambio"])
          && progress is map
          && progress.keys().hasAll(["pesos", "fechaActualizacion"])
          && progress.diff(previousProgress).affectedKeys()
            .hasOnly(["pesos", "fechaActualizacion"])
          && weights is list
          && weights.size() > 0
          && latestWeight is map
          && latestWeight.keys().hasAll(["peso", "fecha"])
          && latestWeight.peso == request.resource.data.peso
          && latestWeight.fecha is string
          && latestWeight.fecha.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && request.resource.data.peso is number
          && request.resource.data.peso >= 20
          && request.resource.data.peso <= 400
          && request.resource.data.fechaUltimoCambio is timestamp
          && progress.fechaActualizacion is timestamp;
      }

      function validProgressGoalUpdate() {
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();
        let progress = request.resource.data.get("progreso", {});
        let previousProgress = resource.data.get("progreso", {});
        return changedFields.hasAll(["progreso", "fechaUltimoCambio"])
          && changedFields.hasOnly([
            "progreso",
            "objetivo",
            "pesoObjetivo",
            "fechaUltimoCambio"
          ])
          && progress is map
          && progress.keys().hasAll([
            "objetivo",
            "pesoObjetivo",
            "fechaActualizacion"
          ])
          && progress.diff(previousProgress).affectedKeys()
            .hasOnly(["objetivo", "pesoObjetivo", "fechaActualizacion"])
          && request.resource.data.objetivo is string
          && request.resource.data.objetivo.size() > 0
          && request.resource.data.objetivo.size() <= 100
          && progress.objetivo == request.resource.data.objetivo
          && (
            request.resource.data.pesoObjetivo == null
            || (
              request.resource.data.pesoObjetivo is number
              && request.resource.data.pesoObjetivo >= 20
              && request.resource.data.pesoObjetivo <= 400
            )
          )
          && progress.pesoObjetivo == request.resource.data.pesoObjetivo
          && request.resource.data.fechaUltimoCambio is timestamp
          && progress.fechaActualizacion is timestamp;
      }

      function validMeasurementProgressUpdate() {
        let changedFields = request.resource.data.diff(resource.data).affectedKeys();
        let progress = request.resource.data.get("progreso", {});
        let previousProgress = resource.data.get("progreso", {});
        let measurements = progress.get("medidas", []);
        let latestMeasurement = measurements[measurements.size() - 1];
        return changedFields.hasAll(["progreso", "fechaUltimoCambio"])
          && changedFields.hasOnly(["progreso", "fechaUltimoCambio"])
          && progress is map
          && progress.keys().hasAll(["medidas", "fechaActualizacion"])
          && progress.diff(previousProgress).affectedKeys()
            .hasOnly(["medidas", "fechaActualizacion"])
          && measurements is list
          && measurements.size() > 0
          && latestMeasurement is map
          && latestMeasurement.keys().hasOnly([
            "fecha",
            "cintura",
            "cadera",
            "brazos",
            "muslos"
          ])
          && latestMeasurement.keys().hasAll(["fecha"])
          && latestMeasurement.keys().hasAny([
            "cintura",
            "cadera",
            "brazos",
            "muslos"
          ])
          && latestMeasurement.fecha is string
          && latestMeasurement.fecha.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && (
            !latestMeasurement.keys().hasAny(["cintura"])
            || (
              latestMeasurement.cintura is number
              && latestMeasurement.cintura >= 10
              && latestMeasurement.cintura <= 250
            )
          )
          && (
            !latestMeasurement.keys().hasAny(["cadera"])
            || (
              latestMeasurement.cadera is number
              && latestMeasurement.cadera >= 10
              && latestMeasurement.cadera <= 250
            )
          )
          && (
            !latestMeasurement.keys().hasAny(["brazos"])
            || (
              latestMeasurement.brazos is number
              && latestMeasurement.brazos >= 10
              && latestMeasurement.brazos <= 250
            )
          )
          && (
            !latestMeasurement.keys().hasAny(["muslos"])
            || (
              latestMeasurement.muslos is number
              && latestMeasurement.muslos >= 10
              && latestMeasurement.muslos <= 250
            )
          )
          && request.resource.data.fechaUltimoCambio is timestamp
          && progress.fechaActualizacion is timestamp;
      }

      allow update: if ownsClient(clientId)
        && (
          attendanceOnlyUpdate()
          || validWeightProgressUpdate()
          || validProgressGoalUpdate()
          || validMeasurementProgressUpdate()
        );
    }

    match /asistencias/{attendanceId} {
      allow create: if request.resource.data.keys().hasAll([
          "nombreUsuario",
          "usuario",
          "hora",
          "fecha",
          "cliente",
          "nombreCliente",
          "estado"
        ])
        && request.resource.data.cliente is string
        && ownsClient(request.resource.data.cliente)
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches(
          "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        )
        && attendanceId
          == request.resource.data.cliente + "_" + request.resource.data.fecha
        && request.resource.data.nombreUsuario is string
        && request.resource.data.usuario is string
        && request.resource.data.hora is timestamp
        && request.resource.data.nombreCliente is string
        && request.resource.data.estado == "presente";
    }

    match /favoritos_recetas/{favoriteId} {
      allow create, update: if request.resource.data.clienteId is string
        && request.resource.data.recetaId is string
        && favoriteId
          == request.resource.data.clienteId
            + "_"
            + request.resource.data.recetaId
        && ownsClient(request.resource.data.clienteId);

      allow delete: if ownsClient(resource.data.clienteId);
    }

    match /conversaciones_chatbot/{conversationId} {
      allow create: if request.resource.data.clienteId is string
        && ownsClient(request.resource.data.clienteId);

      allow read, delete: if ownsClient(resource.data.clienteId);

      allow update: if ownsClient(resource.data.clienteId)
        && request.resource.data.clienteId == resource.data.clienteId;

      match /mensajes/{messageId} {
        function ownsConversation() {
          let conversationPath =
            /databases/$(database)/documents/conversaciones_chatbot/$(conversationId);
          return exists(conversationPath)
            && ownsClient(get(conversationPath).data.clienteId);
        }

        allow read, delete: if ownsConversation();

        allow create: if ownsConversation()
          && request.resource.data.from in ["user", "bot"]
          && request.resource.data.text is string;
      }
    }

    match /{document=**} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == 'admin';
    }
  }
}
